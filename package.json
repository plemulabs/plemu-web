{
  "name": "@plemu-labs/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs && vitest run",
    "format:check": "prettier --check components lib app/globals.css app/play-system.css app/handheld.css app/guide/guide.css app/devnet.css app/market-terminal.css app/native-studio.css scripts next.config.ts",
    "check:assets": "node scripts/verify-assets.mjs",
    "prebuild": "npm run check:assets"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@solana-mobile/wallet-adapter-mobile": "2.3.0",
    "@solana/kit": "8.6.0",
    "@solana/program-client-core": "8.6.0",
    "@solana/wallet-adapter-base": "^0.9.28",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/wallet-adapter-react-ui": "^0.9.40",
    "@solana/wallet-standard-wallet-adapter-react": "1.1.8",
    "@solana/web3.js": "^1.99.0",
    "buffer": "6.0.3",
    "gsap": "^3.15.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
